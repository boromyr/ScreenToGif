<c:ExWindow x:Class="ScreenToGif.Windows.Options"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="clr-namespace:ScreenToGif.Controls"
            Title="{DynamicResource S.Options.Title}" Height="656" Width="826" MinWidth="780" MinHeight="460" 
            Icon="/Resources/Logo.ico" ShowCustomCaptionButtons="True" ExtendIntoTitleBar="False"
            WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
            Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,4,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="90"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!--Options-->
            <ListView Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" x:Name="SectionsListView" Margin="0,0,8,0" MaxWidth="200" MinWidth="150" BorderThickness="0"
                      Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SectionsListView_SelectionChanged">
                <ListView.Resources>
                    <Style BasedOn="{StaticResource {x:Type c:ExListViewItem}}" TargetType="{x:Type c:ExListViewItem}">
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="ContentWidth" Value="18"/>
                        <Setter Property="ContentHeight" Value="18"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </ListView.Resources>

                <c:ExListViewItem Content="{DynamicResource S.Options.App}" Icon="{StaticResource Vector.Application}" IsSelected="True"/>
                <c:ExListViewItem Content="{DynamicResource S.Options.Recorder}" Icon="{StaticResource Vector.Record}"/>
                <c:ExListViewItem Content="{DynamicResource S.Options.Editor}" Icon="{StaticResource Vector.Editor}"/>
                <c:ExListViewItem Content="{DynamicResource S.Options.Tasks}" Icon="{StaticResource Vector.Encoder}"/>
                <c:ExListViewItem Content="{DynamicResource S.Options.Shortcuts}" Icon="{StaticResource Vector.Keyboard}"/>
                <c:ExListViewItem Content="{DynamicResource S.Options.Language}" Icon="{StaticResource Vector.Translate}"/>
                <c:ExListViewItem Content="{DynamicResource S.Options.Storage}" Icon="{StaticResource Vector.Temporary}"/>
                <c:ExListViewItem Content="{DynamicResource S.Options.Upload}" Icon="{StaticResource Vector.Web}"/>
                <c:ExListViewItem Content="{DynamicResource S.Options.Extras}" Icon="{StaticResource Vector.Extras}"/>
                <c:ExListViewItem Content="{DynamicResource S.Options.Donate}" Icon="{StaticResource Vector.Money}"/>
                <c:ExListViewItem Content="{DynamicResource S.Options.About}" Icon="{StaticResource Vector.Info}"/>
            </ListView>

            <!--Content card-->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" CornerRadius="8" BorderThickness="1" Padding="8,6"
                    Background="{DynamicResource Fluent.Card.Background}" BorderBrush="{DynamicResource Fluent.Card.Border}">
                <Frame x:Name="Frame" JournalOwnership="UsesParentJournal" Focusable="False" IsTabStop="False"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto" MinWidth="110"/>
            </Grid.ColumnDefinitions>

            <c:ExtendedButton Grid.Column="2" x:Name="OkButton" Text="{DynamicResource S.Ok}" Margin="0,8" Padding="2,0" MinWidth="120" 
                              ContentHeight="16" ContentWidth="16" Icon="{c:FluentIcon E73E, Brush=Fluent.Text.OnAccent}" Click="OkButton_Click"
                              Style="{StaticResource Fluent.Button.Accent}"/>
        </Grid>
    </Grid>
</c:ExWindow>