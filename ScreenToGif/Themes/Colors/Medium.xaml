<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <s:Double x:Key="Element.Opacity">0.9</s:Double>

    <!--Fluent palette (Windows 11). The legacy brushes below are mapped to these colors.-->
    <Color x:Key="Fluent.Color.Window">#FFE6E6E6</Color>
    <Color x:Key="Fluent.Color.Card">#FFEFEFEF</Color>
    <Color x:Key="Fluent.Color.CardBorder">#FFD4D4D4</Color>
    <Color x:Key="Fluent.Color.Divider">#FFCCCCCC</Color>
    <Color x:Key="Fluent.Color.Control">#FFF7F7F7</Color>
    <Color x:Key="Fluent.Color.ControlHover">#FFF0F0F0</Color>
    <Color x:Key="Fluent.Color.ControlPressed">#FFE9E9E9</Color>
    <Color x:Key="Fluent.Color.ControlBorder">#FFC8C8C8</Color>
    <Color x:Key="Fluent.Color.ControlBorderHover">#FFB8B8B8</Color>
    <Color x:Key="Fluent.Color.Input">#FFF7F7F7</Color>
    <Color x:Key="Fluent.Color.InputFocused">#FFFFFFFF</Color>
    <Color x:Key="Fluent.Color.Text">#FF000000</Color>
    <Color x:Key="Fluent.Color.TextSecondary">#FF505050</Color>
    <Color x:Key="Fluent.Color.TextOnAccent">#FFFFFFFF</Color>
    <Color x:Key="Fluent.Color.SubtleHover">#14000000</Color>
    <Color x:Key="Fluent.Color.SubtlePressed">#22000000</Color>
    <Color x:Key="Fluent.Color.Record">#FFD13438</Color>
    <Color x:Key="Fluent.Color.Success">#FF0F7B0F</Color>
    <Color x:Key="Fluent.Color.Critical">#FFC42B1C</Color>
    <Color x:Key="Fluent.Color.Caution">#FF9D5D00</Color>
    <x:Static x:Key="Fluent.Color.Accent" Member="SystemColors.AccentColorDark1"/>

    <!--Shadows-->
    <DropShadowEffect x:Key="Shadow.Background.Tiny" ShadowDepth="0" Color="#FFD6D6D6" Opacity=".6" BlurRadius="1" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="Shadow.Background.Small" ShadowDepth="0" Color="#FFD6D6D6" Opacity=".6" BlurRadius="2" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="Shadow.Background" ShadowDepth="0" Color="#FFD6D6D6" Opacity=".6" BlurRadius="3" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="Shadow.Background.Large" ShadowDepth="0" Color="#FFD6D6D6" Opacity=".6" BlurRadius="5" RenderingBias="Quality"/>

    <DropShadowEffect x:Key="Shadow.Border.Tiny" ShadowDepth="0" Color="#FF969696" Opacity=".35" BlurRadius="2" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="Shadow.Border.Small" ShadowDepth="0" Color="#FF969696" Opacity=".4" BlurRadius="3" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="Shadow.Border" ShadowDepth="0" Color="#FF969696" Opacity=".5" BlurRadius="3" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="Shadow.Border.Large" ShadowDepth="0" Color="#FF969696" Opacity=".4" BlurRadius="5" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="Shadow.Border.Dark" ShadowDepth="0" Color="#FF969696" Opacity=".5" BlurRadius="3" RenderingBias="Quality"/>

    <!--Gradients-->
    <Color x:Key="Gradient.Border.Light">#4FA7B0B8</Color>
    
    <!--Colors-->
    <SolidColorBrush x:Key="Panel.Background" Color="{StaticResource Fluent.Color.Window}"/>
    <SolidColorBrush x:Key="Panel.Background.Level2" Color="{StaticResource Fluent.Color.Card}"/>
    <SolidColorBrush x:Key="Panel.Background.Level3" Color="{StaticResource Fluent.Color.Window}"/>
    <SolidColorBrush x:Key="Panel.Background.Level4" Color="{StaticResource Fluent.Color.Card}"/>

    <SolidColorBrush x:Key="Element.Background" Color="{StaticResource Fluent.Color.Input}"/>
    <SolidColorBrush x:Key="Element.Background.Hover" Color="{StaticResource Fluent.Color.ControlHover}"/>
    <SolidColorBrush x:Key="Element.Background.Focused" Color="{StaticResource Fluent.Color.InputFocused}"/>
    <SolidColorBrush x:Key="Element.Background.Pressed" Color="{StaticResource Fluent.Color.ControlPressed}"/>
    <SolidColorBrush x:Key="Element.Background.Checked" Color="{StaticResource Fluent.Color.SubtlePressed}"/>
    <SolidColorBrush x:Key="Element.Background.Back" Color="{StaticResource Fluent.Color.Window}"/>
    <SolidColorBrush x:Key="Element.Background.ReadOnly" Color="{StaticResource Fluent.Color.Window}"/>

    <SolidColorBrush x:Key="Element.Foreground" Color="{StaticResource Fluent.Color.Text}"/>
    <SolidColorBrush x:Key="Element.Foreground.Medium" Color="{StaticResource Fluent.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Element.Foreground.Gray112" Color="{StaticResource Fluent.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Element.Foreground.Gray150" Color="#FF767676"/>
    <SolidColorBrush x:Key="Element.Foreground.Watermark" Color="#FF898989"/>
    <SolidColorBrush x:Key="Element.Foreground.Gray192" Color="#FFA0A0A0"/>
    <SolidColorBrush x:Key="Element.Foreground.Gray208" Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="Element.Foreground.Header" Color="{StaticResource Fluent.Color.Accent}"/>
    <SolidColorBrush x:Key="Element.Foreground.Detail" Color="#FF289746"/>
    <SolidColorBrush x:Key="Element.Foreground.Hint" Color="{StaticResource Fluent.Color.Success}"/>

    <SolidColorBrush x:Key="Element.Border" Color="{StaticResource Fluent.Color.ControlBorder}"/>
    <SolidColorBrush x:Key="Element.Border.Medium" Color="{StaticResource Fluent.Color.ControlBorder}"/>
    <SolidColorBrush x:Key="Element.Border.Light" Color="{StaticResource Fluent.Color.Divider}"/>
    <SolidColorBrush x:Key="Element.Border.Hover" Color="{StaticResource Fluent.Color.ControlBorderHover}"/>
    <SolidColorBrush x:Key="Element.Border.Pressed" Color="{StaticResource Fluent.Color.Accent}"/>
    <SolidColorBrush x:Key="Element.Border.Required" Color="DarkBlue"/>

    <SolidColorBrush x:Key="Element.Glyph" Color="{StaticResource Fluent.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Element.Glyph.Strong" Color="{StaticResource Fluent.Color.Text}"/>
    <SolidColorBrush x:Key="Element.Glyph.Hover" Color="{StaticResource Fluent.Color.Text}"/>
    <SolidColorBrush x:Key="Element.Glyph.Pressed" Color="{StaticResource Fluent.Color.Text}"/>

    <SolidColorBrush x:Key="Element.Selection" Color="{StaticResource Fluent.Color.Accent}"/>
    <SolidColorBrush x:Key="Element.Selection.Inactive" Color="#FFF0F0F0"/>

    <!--Buttons-->
    <SolidColorBrush x:Key="Brush.Button.Background" Color="{StaticResource Fluent.Color.Control}"/>
    <SolidColorBrush x:Key="Brush.Button.Background.Hover" Color="{StaticResource Fluent.Color.SubtleHover}"/>
    <SolidColorBrush x:Key="Brush.Button.Background.Checked" Color="{StaticResource Fluent.Color.SubtlePressed}"/>
    <SolidColorBrush x:Key="Brush.Button.Background.Pressed" Color="{StaticResource Fluent.Color.SubtlePressed}"/>
    <SolidColorBrush x:Key="Brush.Button.Background.Focused" Color="Transparent"/>

    <SolidColorBrush x:Key="Brush.Button.Border" Color="{StaticResource Fluent.Color.ControlBorder}"/>
    <SolidColorBrush x:Key="Brush.Button.Border.Hover" Color="{StaticResource Fluent.Color.ControlBorder}"/>
    <SolidColorBrush x:Key="Brush.Button.Border.Pressed" Color="{StaticResource Fluent.Color.ControlBorder}"/>
    <SolidColorBrush x:Key="Brush.Button.Border.Focused" Color="{StaticResource Fluent.Color.Accent}"/>

    <!--Button • Paypal-->
    <SolidColorBrush x:Key="Brush.Button.Paypal.Background" Color="#F0FFF8EB"/>
    <SolidColorBrush x:Key="Brush.Button.Paypal.Background.Hover" Color="#FFF9E7C3"/>
    <SolidColorBrush x:Key="Brush.Button.Paypal.Background.Pressed" Color="#FFEEB860"/>

    <SolidColorBrush x:Key="Brush.Button.Paypal.Border" Color="#F0FBDBA6"/>
    <SolidColorBrush x:Key="Brush.Button.Paypal.Border.Hover" Color="#FFEEB860"/>
    <SolidColorBrush x:Key="Brush.Button.Paypal.Border.Pressed" Color="#FFFFB437"/>

    <SolidColorBrush x:Key="Brush.Button.Paypal.Foreground" Color="#FF143A61"/>

    <!--ScrollBar-->
    <SolidColorBrush x:Key="Brush.ScrollBar.Background" Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="Brush.ScrollBar.Background.Back" Color="#FFEFEFEF"/>
    <SolidColorBrush x:Key="Brush.ScrollBar.Background.Hover" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="Brush.ScrollBar.Background.Pressed" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="Brush.ScrollBar.Border" Color="#FFABABAB"/>
    <SolidColorBrush x:Key="Brush.ScrollBar.Border.Hover" Color="#FFABABAB"/>
    <SolidColorBrush x:Key="Brush.ScrollBar.Border.Pressed" Color="#FF777777"/>

    <!--DataGrid-->
    <SolidColorBrush x:Key="Brush.DataGrid.RowHeader.Background" Color="LightBlue"/>
    <SolidColorBrush x:Key="Brush.DataGrid.RowHeader.Background.Hovered" Color="#FF73BCD4"/>

    <SolidColorBrush x:Key="Brush.DataGrid.Foreground.Selected" Color="White"/>
    <SolidColorBrush x:Key="Brush.DataGrid.Background.Selected" Color="SlateBlue"/>
    <SolidColorBrush x:Key="Brush.DataGrid.Background.Alternation1" Color="White"/>
    <SolidColorBrush x:Key="Brush.DataGrid.Background.Alternation2" Color="PowderBlue"/>

    <SolidColorBrush x:Key="Brush.DataGrid.Border" Color="#F0007CAA"/>

    <SolidColorBrush x:Key="Brush.DataGrid.Header.Border" Color="#FF336584"/>

    <SolidColorBrush x:Key="Brush.DataGrid.Header.Foreground" Color="White"/>
    <SolidColorBrush x:Key="Brush.DataGrid.Header.Foreground.Hover" Color="Black"/>
    <SolidColorBrush x:Key="Brush.DataGrid.Header.Foreground.Pressed" Color="Black"/>

    <SolidColorBrush x:Key="Brush.DataGrid.Header.Background" Color="#FF397093"/>
    <SolidColorBrush x:Key="Brush.DataGrid.Header.Background.Hover" Color="#FF70A6C8"/>
    <SolidColorBrush x:Key="Brush.DataGrid.Header.Background.Pressed" Color="#FF89B6D1"/>

    <SolidColorBrush x:Key="Brush.DataGrid.Header.Glyph" Color="WhiteSmoke"/>
    <SolidColorBrush x:Key="Brush.DataGrid.Header.Glyph.Hover" Color="Black"/>
    <SolidColorBrush x:Key="Brush.DataGrid.Header.Glyph.Pressed" Color="Black"/>

    <!--MenuItem-->
    <SolidColorBrush x:Key="Brush.MenuItem.Background.Hover" Color="{StaticResource Fluent.Color.SubtleHover}"/>
    <SolidColorBrush x:Key="Brush.MenuItem.Border.Hover" Color="Transparent"/>
    <SolidColorBrush x:Key="Brush.MenuItem.Background.Pressed" Color="{StaticResource Fluent.Color.SubtlePressed}"/>

    <!--StatusBand-->
    <SolidColorBrush x:Key="Brush.StatusBand.Info" Color="#FFD4D4F8"/>
    <SolidColorBrush x:Key="Brush.StatusBand.Warning" Color="#FFFCF7B6"/>
    <SolidColorBrush x:Key="Brush.StatusBand.Error" Color="#FFF8D4D4"/>

    <!--Hyperlink-->
    <SolidColorBrush x:Key="Brush.Hyperlink" Color="{StaticResource Fluent.Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Hyperlink.Hover" Color="DarkRed"/>
    <SolidColorBrush x:Key="Brush.Hyperlink.Disabled" Color="DarkSlateGray"/>

    <!--ListBoxItem-->
    <SolidColorBrush x:Key="Item.MouseOver.Background" Color="{StaticResource Fluent.Color.SubtleHover}"/>
    <SolidColorBrush x:Key="Item.MouseOver.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="Item.SelectedInactive.Background" Color="{StaticResource Fluent.Color.SubtleHover}"/>
    <SolidColorBrush x:Key="Item.SelectedInactive.Border" Color="{StaticResource Fluent.Color.ControlBorderHover}"/>
    <SolidColorBrush x:Key="Item.SelectedActive.Background" Color="{StaticResource Fluent.Color.SubtlePressed}"/>
    <SolidColorBrush x:Key="Item.SelectedActive.Border" Color="{StaticResource Fluent.Color.Accent}"/>

    <!--ProgressBar-->
    <SolidColorBrush x:Key="Brush.ProgressBar.Detail" Color="#60EFEFEF"/>
    <SolidColorBrush x:Key="Brush.ProgressBar.Primary" Color="#FF06B025"/>
    <SolidColorBrush x:Key="Brush.ProgressBar.Info" Color="#FF0078D7"/>
    <SolidColorBrush x:Key="Brush.ProgressBar.Warning" Color="#FFC8CF07"/>
    <SolidColorBrush x:Key="Brush.ProgressBar.Danger" Color="#FFC50500"/>

    <!--Fluent brushes-->
    <SolidColorBrush x:Key="Fluent.Window.Background" Color="{StaticResource Fluent.Color.Window}"/>
    <SolidColorBrush x:Key="Fluent.Card.Background" Color="{StaticResource Fluent.Color.Card}"/>
    <SolidColorBrush x:Key="Fluent.Card.Border" Color="{StaticResource Fluent.Color.CardBorder}"/>
    <SolidColorBrush x:Key="Fluent.Divider" Color="{StaticResource Fluent.Color.Divider}"/>
    <SolidColorBrush x:Key="Fluent.Control.Background" Color="{StaticResource Fluent.Color.Control}"/>
    <SolidColorBrush x:Key="Fluent.Control.Background.Hover" Color="{StaticResource Fluent.Color.ControlHover}"/>
    <SolidColorBrush x:Key="Fluent.Control.Background.Pressed" Color="{StaticResource Fluent.Color.ControlPressed}"/>
    <SolidColorBrush x:Key="Fluent.Control.Border" Color="{StaticResource Fluent.Color.ControlBorder}"/>
    <SolidColorBrush x:Key="Fluent.Control.Border.Hover" Color="{StaticResource Fluent.Color.ControlBorderHover}"/>
    <SolidColorBrush x:Key="Fluent.Input.Background" Color="{StaticResource Fluent.Color.Input}"/>
    <SolidColorBrush x:Key="Fluent.Input.Background.Focused" Color="{StaticResource Fluent.Color.InputFocused}"/>
    <SolidColorBrush x:Key="Fluent.Text.Primary" Color="{StaticResource Fluent.Color.Text}"/>
    <SolidColorBrush x:Key="Fluent.Text.Secondary" Color="{StaticResource Fluent.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Fluent.Text.OnAccent" Color="{StaticResource Fluent.Color.TextOnAccent}"/>
    <SolidColorBrush x:Key="Fluent.Subtle.Hover" Color="{StaticResource Fluent.Color.SubtleHover}"/>
    <SolidColorBrush x:Key="Fluent.Subtle.Pressed" Color="{StaticResource Fluent.Color.SubtlePressed}"/>
    <SolidColorBrush x:Key="Fluent.Record" Color="{StaticResource Fluent.Color.Record}"/>
    <SolidColorBrush x:Key="Fluent.Success" Color="{StaticResource Fluent.Color.Success}"/>
    <SolidColorBrush x:Key="Fluent.Critical" Color="{StaticResource Fluent.Color.Critical}"/>
    <SolidColorBrush x:Key="Fluent.Caution" Color="{StaticResource Fluent.Color.Caution}"/>
    <SolidColorBrush x:Key="Fluent.Accent" Color="{StaticResource Fluent.Color.Accent}"/>
    <SolidColorBrush x:Key="Fluent.Accent.Hover" Color="{StaticResource Fluent.Color.Accent}" Opacity="0.9"/>
    <SolidColorBrush x:Key="Fluent.Accent.Pressed" Color="{StaticResource Fluent.Color.Accent}" Opacity="0.8"/>
    <DropShadowEffect x:Key="Fluent.Shadow" ShadowDepth="1" Direction="270" Color="Black" Opacity=".1" BlurRadius="8" RenderingBias="Performance"/>
</ResourceDictionary>